---
/**
 * LE TERMINUS — le dessin du trajet, sous le titre qu'il illustre.
 *
 * Trois lignes mènent au club, et toutes les trois s'y arrêtent : la 79 depuis
 * Labège, la Linéo L6 depuis Castanet, le métro B depuis Toulouse. Elles
 * finissent au même endroit — c'est ce que le dessin montre : un schéma de
 * réseau qui converge sur un terminus, barre de fin de ligne comprise.
 *
 * Le nœud d'arrivée est un octogone, parce que c'est ce qu'il y a au bout :
 * l'octogone de sept mètres du club.
 *
 * Il vit dans la section « Y aller », sous le titre qui dit la ligne — dans le
 * héros, il coûtait presque un écran avant le premier mot sur le club. Sur
 * téléphone, le tracé vertical tient en un demi-écran.
 *
 * Chaque étiquette vient du registre : les lignes, les départs, l'arrêt, les
 * cotes. Tout est en SVG inline — aucun canvas, aucune bibliothèque, aucune
 * requête. Sans JavaScript et en mouvement réduit, le plan est déjà fini.
 */
import { SITE, DESTINATION } from '../data/verite';
import { ITINERAIRES, MEILLEUR, ARRIVEE, type Etape } from '../data/transports';

const fait = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const nomLigne = (e: Etape) =>
  e.mode === 'metro' ? `MÉTRO ${e.code}` : /^L\d/.test(e.code) ? `LINÉO ${e.code}` : `LIGNE ${e.code}`;

/** Les trois départs, dans l'ordre du dessin : le métro en haut, la ligne de la ville au milieu, l'autre bus en bas. */
const METRO = ITINERAIRES.find((i) => i.mode === 'metro') ?? ITINERAIRES[0];
const AUTRE = ITINERAIRES.find((i) => i !== METRO && i !== MEILLEUR) ?? ITINERAIRES[0];
const HAUT = METRO.etapes[0];
const MILIEU = MEILLEUR.etapes[0];
const BAS = AUTRE.etapes[0];
const RUE = DESTINATION.adresse.split(',')[0];
---

<figure class="plan" data-plan>
  <figcaption class="vh">
    Trois lignes mènent au club et s’y arrêtent : {nomLigne(MILIEU).toLowerCase()} depuis {MILIEU.de},
    {nomLigne(BAS).toLowerCase()} depuis {BAS.de}, {nomLigne(HAUT).toLowerCase()} depuis {HAUT.de}. Toutes
    finissent à {DESTINATION.ville}, où {DESTINATION.nom} occupe {DESTINATION.singularite}
    Ouvert {DESTINATION.horaires.valeur}.
  </figcaption>

  {/* ── Tracé horizontal — écrans larges ── */}
  <svg
    class="plan__svg plan__svg--h"
    viewBox="0 0 1200 440"
    role="img"
    aria-hidden="true"
    preserveAspectRatio="xMidYMid meet"
  >
    <path class="plan__trait" d="M 150 80 H 620 L 916 190" fill="none" />
    <path class="plan__trait" d="M 150 220 H 940" fill="none" />
    <path class="plan__trait" d="M 150 360 H 620 L 916 250" fill="none" />

    <path class="plan__voie plan__voie--1" d="M 150 80 H 620 L 916 190" fill="none" pathLength="100" />
    <path class="plan__voie plan__voie--2" d="M 150 220 H 940" fill="none" pathLength="100" />
    <path class="plan__voie plan__voie--3" d="M 150 360 H 620 L 916 250" fill="none" pathLength="100" />

    <g class="plan__depart" style="--rang:1">
      <circle cx="150" cy="80" r="6" />
      <text class="plan__depart-code" x="150" y="52" text-anchor="middle">{nomLigne(HAUT)}</text>
      <text class="plan__depart-nom" x="150" y="34" text-anchor="middle">{HAUT.de.toUpperCase()}</text>
    </g>
    <g class="plan__depart" style="--rang:2">
      <circle cx="150" cy="220" r="6" />
      <text class="plan__depart-code" x="150" y="194" text-anchor="middle">{nomLigne(MILIEU)}</text>
      <text class="plan__depart-nom" x="150" y="176" text-anchor="middle">{MILIEU.de.toUpperCase()}</text>
    </g>
    <g class="plan__depart" style="--rang:3">
      <circle cx="150" cy="360" r="6" />
      <text class="plan__depart-code" x="150" y="388" text-anchor="middle">{nomLigne(BAS)}</text>
      <text class="plan__depart-nom" x="150" y="410" text-anchor="middle">{BAS.de.toUpperCase()}</text>
    </g>

    <g class="plan__cote" style="--rang:1">
      <path class="plan__cote-ligne" d="M 700 220 V 148" />
      <path class="plan__cote-tick" d="M 692 148 H 708" />
      <text class="plan__cote-texte" x="700" y="132" text-anchor="middle">{fait('Surface')}</text>
    </g>
    <g class="plan__cote" style="--rang:2">
      <path class="plan__cote-ligne" d="M 460 220 V 292" />
      <path class="plan__cote-tick" d="M 452 292 H 468" />
      <text class="plan__cote-texte" x="460" y="314" text-anchor="middle">{fait('Équipement')}</text>
    </g>

    <g class="plan__terminus">
      <path class="plan__barre" d="M 990 158 V 282" />
      <polygon class="plan__octogone" points="940,196 954,182 974,182 988,196 988,216 974,230 954,230 940,216" />
      <circle class="plan__coeur" cx="964" cy="206" r="5" />
      <text class="plan__terminus-nom" x="964" y="268" text-anchor="middle">{ARRIVEE.arret.toUpperCase()}</text>
      <text class="plan__terminus-cp" x="964" y="286" text-anchor="middle">{RUE} · {fait('Cours')}</text>
    </g>
  </svg>

  {/* ── Tracé vertical — téléphones ── */}
  <svg
    class="plan__svg plan__svg--v"
    viewBox="0 0 360 620"
    role="img"
    aria-hidden="true"
    preserveAspectRatio="xMidYMid meet"
  >
    <path class="plan__trait" d="M 60 90 V 380 L 172 452" fill="none" />
    <path class="plan__trait" d="M 180 90 V 468" fill="none" />
    <path class="plan__trait" d="M 300 90 V 380 L 188 452" fill="none" />

    <path class="plan__voie plan__voie--1" d="M 60 90 V 380 L 172 452" fill="none" pathLength="100" />
    <path class="plan__voie plan__voie--2" d="M 180 90 V 468" fill="none" pathLength="100" />
    <path class="plan__voie plan__voie--3" d="M 300 90 V 380 L 188 452" fill="none" pathLength="100" />

    <g class="plan__depart" style="--rang:1">
      <circle cx="60" cy="90" r="6" />
      <text class="plan__depart-code" x="60" y="66" text-anchor="middle">{nomLigne(HAUT)}</text>
      <text class="plan__depart-nom" x="60" y="46" text-anchor="middle">{HAUT.de.toUpperCase()}</text>
    </g>
    <g class="plan__depart" style="--rang:2">
      <circle cx="180" cy="90" r="6" />
      <text class="plan__depart-code" x="180" y="66" text-anchor="middle">{nomLigne(MILIEU)}</text>
      <text class="plan__depart-nom" x="180" y="46" text-anchor="middle">{MILIEU.de.toUpperCase()}</text>
    </g>
    <g class="plan__depart" style="--rang:3">
      <circle cx="300" cy="90" r="6" />
      <text class="plan__depart-code" x="300" y="66" text-anchor="middle">{nomLigne(BAS)}</text>
      <text class="plan__depart-nom" x="300" y="46" text-anchor="middle">{BAS.de.split('-')[0].toUpperCase()}</text>
    </g>

    <g class="plan__cote" style="--rang:1">
      <path class="plan__cote-ligne" d="M 180 220 H 268" />
      <path class="plan__cote-tick" d="M 268 212 V 228" />
      <text class="plan__cote-texte" x="272" y="204" text-anchor="end">{fait('Surface')}</text>
    </g>
    <g class="plan__cote" style="--rang:2">
      <path class="plan__cote-ligne" d="M 180 320 H 92" />
      <path class="plan__cote-tick" d="M 92 312 V 328" />
      <text class="plan__cote-texte" x="88" y="304" text-anchor="start">{fait('Équipement')}</text>
    </g>

    <g class="plan__terminus">
      <path class="plan__barre" d="M 122 512 H 238" />
      <polygon class="plan__octogone" points="166,458 180,444 194,458 194,472 180,486 166,472" />
      <circle class="plan__coeur" cx="180" cy="466" r="5" />
      <text class="plan__terminus-nom" x="180" y="546" text-anchor="middle">{ARRIVEE.arret.toUpperCase()}</text>
      <text class="plan__terminus-cp" x="180" y="566" text-anchor="middle">{RUE}</text>
    </g>
  </svg>

  <p class="plan__bloc mono">
    <span><b>{SITE.ville}</b> → {DESTINATION.ville}</span>
    <span>{DESTINATION.nom}</span>
    <span class="plan__bloc-src">{DESTINATION.adresse}</span>
  </p>
</figure>

<style>
  .plan { position: relative; margin: 0; }
  .plan__svg { width: 100%; height: auto; overflow: visible; }
  .plan__svg--v { display: none; }
  @media (max-width: 48rem) {
    .plan__svg--h { display: none; }
    /* Un demi-écran de téléphone : les trois départs et le terminus d'un coup. */
    .plan__svg--v { display: block; max-width: 17rem; margin-inline: auto; }
  }

  .plan__trait {
    stroke: var(--graphite);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.4;
  }

  /* Les trois voies se tracent l'une après l'autre, vers le terminus. */
  .plan__voie {
    stroke: var(--signal-texte);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    fill: none;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: tracer 900ms var(--e-resolution) forwards;
  }
  .plan__voie--1 { animation-delay: 200ms; opacity: 0.55; }
  .plan__voie--2 { animation-delay: 360ms; }
  .plan__voie--3 { animation-delay: 520ms; opacity: 0.55; }
  @keyframes tracer { to { stroke-dashoffset: 0; } }

  .plan__depart {
    opacity: 0;
    animation: apparaitre 380ms var(--e-sortie) forwards;
    animation-delay: calc(var(--rang) * 160ms);
  }
  @keyframes apparaitre { to { opacity: 1; } }
  .plan__depart circle { fill: var(--encre); }
  .plan__depart-nom {
    font-family: var(--police-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    fill: var(--encre);
  }
  .plan__depart-code {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--signal-texte);
  }

  .plan__cote {
    opacity: 0;
    animation: apparaitre 420ms var(--e-sortie) forwards;
    animation-delay: calc(1400ms + var(--rang) * 120ms);
  }
  .plan__cote-ligne,
  .plan__cote-tick {
    stroke: var(--graphite);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    fill: none;
    opacity: 0.7;
  }
  .plan__cote-ligne { stroke-dasharray: 4 4; }
  .plan__cote-texte {
    font-family: var(--police-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: var(--signal-texte);
  }

  /* Le terminus : la barre de fin de ligne, et l'octogone du club. */
  .plan__terminus {
    opacity: 0;
    animation: apparaitre 420ms var(--e-sortie) 1500ms forwards;
  }
  .plan__barre {
    stroke: var(--encre);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    fill: none;
  }
  .plan__octogone {
    fill: var(--papier-vif);
    stroke: var(--signal-texte);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  .plan__coeur {
    fill: var(--signal-texte);
    transform-box: fill-box;
    transform-origin: center;
    animation: battre 2.6s var(--e-mecanique) 2.2s infinite;
  }
  @keyframes battre {
    0%, 74%, 100% { transform: scale(1); opacity: 1; }
    86% { transform: scale(1.9); opacity: 0.3; }
  }
  .plan__terminus-nom {
    font-family: var(--police-mono);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    fill: var(--encre);
  }
  .plan__terminus-cp {
    font-family: var(--police-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--graphite);
  }

  .plan__bloc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-5);
    margin-top: var(--e-5);
    padding-top: var(--e-3);
    border-top: 1px solid var(--trait);
    text-transform: none;
    letter-spacing: 0.05em;
    color: var(--graphite);
  }
  .plan__bloc b { color: var(--encre); font-weight: 700; }
  .plan__bloc-src { margin-left: auto; }
  @media (max-width: 62rem) { .plan__bloc-src { margin-left: 0; } }

  /* ── Sans script, et en mouvement réduit : le plan est déjà fini. ──── */
  :global(.no-js) .plan__depart,
  :global(.no-js) .plan__cote,
  :global(.no-js) .plan__terminus { animation: none; opacity: 1; }
  :global(.no-js) .plan__voie { stroke-dashoffset: 0; animation: none; }

  @media (prefers-reduced-motion: reduce) {
    .plan__depart,
    .plan__cote,
    .plan__terminus,
    .plan__coeur { animation: none !important; opacity: 1; transform: none; }
    .plan__voie { stroke-dashoffset: 0; animation: none; }
  }
</style>
