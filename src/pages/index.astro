---
/**
 * L'ACCUEIL — dans l'ordre des questions d'un Labégeois, ou d'un salarié de
 * l'Innopole.
 *
 * La page est une démonstration en trois preuves : le lieu (un octogone de
 * sept mètres en plein air, sous un toit), le trajet (un seul bus, la 79,
 * jusqu'au terminus du métro B) et le moment (le midi, le club est déjà
 * ouvert). Le héros pose la thèse ; chaque section fait avancer la preuve
 * d'un cran : le club (02), le trajet avec le plan du terminus sous son titre
 * (03), le secteur, qui prolonge le plan (04), le midi (05), le moteur (06),
 * la première fois (07), les questions (08), décider (09).
 *
 * Aucun titre de section n'existe sur un autre site de la famille. Chaque
 * nombre se compte depuis le registre. Aucune heure de cours n'est écrite :
 * le planning du club la donne.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Terminus from '../components/Terminus.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, VILLE, LIMITROPHES, CONTACT } from '../data/verite';
import { COMMUNES } from '../data/communes';
import { OFFRES, offresDe } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR, DEPARTS, ARRIVEE, enLettres } from '../data/transports';

const fait = (cle: string) => DESTINATION.faits.find((f) => f.cle === cle)?.valeur ?? '';
const majuscule = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const enumerer = (mots: string[]) =>
  mots.length > 1 ? `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}` : mots[0] ?? '';

/** « 22 par semaine » → vingt-deux. Le nombre vient du registre, la lettre d'ici. */
const COURS = enLettres(parseInt(fait('Cours'), 10));
const COMBIEN_INTITULES = enLettres(OFFRES.length);
const [SURFACE, OCTOGONE] = DESTINATION.singularite.replace(/\.$/, '').split(', avec ');
const BUS = MEILLEUR.etapes[0];
const METRO = ITINERAIRES.find((i) => i.mode === 'metro');
const MMA = offresDe('mma')[0];
const ENFANTS = offresDe('enfants')[0];
const depart = (commune: string) => DEPARTS.find((d) => d.depuis === commune)?.texte ?? '';
const [SAINT_ORENS, CASTANET] = COMMUNES;
const ligneDe = (c: (typeof COMMUNES)[number]) => c.cotes[0].valeur.split(',')[0];

/**
 * Les questions, telles qu'on les pose. Chaque réponse s'ouvre sur ce qui est
 * vrai, et les nombres viennent du registre.
 */
const QUESTIONS = [
  {
    titre: `Où est le club de boxe le plus proche de ${SITE.ville} ?`,
    texte: `Au ${DESTINATION.adresse}, au terminus du métro ${METRO?.etapes[0].code ?? 'B'}. ${DESTINATION.nom} y a ${DESTINATION.singularite.replace(/\.$/, '')}, un grand ring et un étage de musculation. La ${BUS.code} part de ${SITE.ville} et finit là-bas, sans changement.`,
  },
  {
    titre: 'Qu’est-ce qu’on peut y pratiquer ?',
    texte: `${majuscule(COMBIEN_INTITULES)} intitulés : ${enumerer(OFFRES.map((o) => o.intitule))}. ${majuscule(COURS)} cours par semaine au total.`,
  },
  {
    titre: `Je n’ai jamais fait de sport de combat. Le club proche de ${SITE.ville} accepte les débutants ?`,
    texte: 'Oui, c’est le cas de la plupart des gens qui s’inscrivent. Le club l’écrit lui-même : tu débutes, tu es le bienvenu. Aucun test à l’entrée, et les gants sont prêtés. Une première séance, c’est de l’échauffement, un geste travaillé lentement, du sac et des pattes d’ours.',
  },
  {
    titre: 'Il y a un vrai octogone pour le MMA ?',
    texte: `Oui, ${OCTOGONE}, et l’entraînement se fait dedans : le cours s’appelle « ${MMA?.intitule ?? 'MMA'} ». Il est sous les ${SURFACE}, ce qui le distingue dans le réseau. Le grappling est un cours à part, sans aucune frappe.`,
  },
  {
    titre: 'Je travaille à l’Innopole. Il y a des cours le midi ?',
    texte: `Le club publie ${COURS} cours par semaine et ouvre ${DESTINATION.horaires.valeur}. Le midi et la sortie de bureau sont les deux créneaux qui tiennent le mieux dans une semaine de travail, et la ${BUS.code} passe par la gare et le village d’entreprise.`,
  },
  {
    titre: 'Comment y aller sans voiture ?',
    texte: `${depart(SITE.ville)} ${ARRIVEE.phrase}`,
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte: `Oui${ENFANTS?.ages ? `, ${ENFANTS.ages}` : ''} : « ${ENFANTS?.intitule ?? 'École enfants'} ». ${ENFANTS?.detail ?? ''}`,
  },
  {
    titre: `J’habite ${SAINT_ORENS.nom} ou ${CASTANET.nom}.`,
    texte: `Chaque commune a sa page ici. ${depart(SAINT_ORENS.nom)} ${depart(CASTANET.nom)}`,
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LE CLUB ─────────── */}
  <section class="section octogone" id="club" aria-labelledby="t-club">
    <div class="enveloppe octogone__inner">
      <div class="octogone__texte">
        <p class="cartouche"><span class="cartouche__num">02</span><span>Le club</span></p>
        <h2 id="t-club">
          {majuscule(SURFACE)},<br />
          <span class="octogone__accent">avec {OCTOGONE}.</span>
        </h2>
        <p class="lead">
          Pour un club de boxe proche de {SITE.ville}, l’adresse est le
          {' '}<strong>{DESTINATION.adresse}</strong>{METRO ? `, au terminus du métro ${METRO.etapes[0].code}` : ''}.
        </p>
        <p class="faible">
          La salle est couverte mais ouverte sur l’extérieur&nbsp;: tu t’entraînes à
          l’air libre, à l’abri. Au rez-de-chaussée, le grand ring et l’octogone, où
          se donne «&nbsp;{MMA?.intitule}&nbsp;»&nbsp;: le club de MMA près de {SITE.ville},
          c’est ce cours-là, debout, au corps à corps et au sol. À l’étage, un plateau
          de musculation et de cardio en accès libre.
        </p>
        <dl class="octogone__faits">
          <div><dt class="mono">Accueil</dt><dd>{DESTINATION.horairesCourt}</dd></div>
          <div><dt class="mono">Téléphone</dt><dd><a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a></dd></div>
        </dl>
        <div class="octogone__actions">
          <a class="bouton bouton--signal" href={DESTINATION.activites} rel="noopener">
            <span>Les {COMBIEN_INTITULES} activités, sur le site du club</span>
            <span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien" href={route('mma').chemin}>Le MMA dans l’octogone →</a>
        </div>
      </div>

      <Photo
        slug={ROLES.signature}
        sizes="(max-width: 62rem) 100vw, 46vw"
        ratio="4 / 5"
        legende
        class="octogone__image"
      />
    </div>
  </section>

  {/* ─────────── 03 — Y ALLER ─────────── */}
  <section class="section trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">03</span><span>Y aller</span></p>
      <div class="trajet__tete">
        <h2 id="t-trajet">
          Un seul bus depuis {SITE.ville}&nbsp;: la {BUS.code},<br />
          <span class="trajet__accent">jusqu’au terminus du métro {METRO?.etapes[0].code}.</span>
        </h2>
        <p class="lead faible">{MEILLEUR.resume} {ARRIVEE.phrase}</p>
      </div>

      <Terminus />

      <ol class="trajet__lignes">
        {ITINERAIRES.map((it, i) => (
          <li class="reveler" style={`--retard:${i * 80}ms`}>
            <a href={`${route('transports').chemin}?trajet=${it.id}`}>
              <span class={`trajet__code trajet__code--${it.etapes[0].mode}`}>{it.etapes[0].code}</span>
              <span class="trajet__parcours">{it.onglet}, depuis {it.etapes[0].de}</span>
              <span class="mono trajet__jours">
                {it.etapes.length === 1 ? 'direct' : `${enLettres(it.etapes.length)} étapes`} · {it.etapes[0].jours}
              </span>
            </a>
          </li>
        ))}
      </ol>

      <div class="trajet__actions">
        <a class="bouton bouton--signal" href={route('transports').chemin}>
          <span>Le trajet, arrêt par arrêt</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={BUS.href} rel="noopener">
          <span>La fiche Tisséo de la {BUS.code}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 04 — LE SECTEUR ─────────── */}
  <section class="section creuse secteur" id="secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">04</span><span>Le secteur</span></p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Depuis {SAINT_ORENS.nom}, la {ligneDe(SAINT_ORENS)} aussi.<br />
          <span class="secteur__accent">Depuis {CASTANET.nom}, la {ligneDe(CASTANET)}.</span>
        </h2>
        <p class="lead faible secteur__intro">
          {depart(SAINT_ORENS.nom)} {depart(CASTANET.nom)} {METRO ? depart(METRO.etapes[0].de) : ''}
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c, i) => (
          <li class="reveler" style={`--retard:${i * 90}ms`}>
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[0].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">{DESTINATION.nomCourt}</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="mono secteur__cle">Les {enLettres(LIMITROPHES.length)} communes limitrophes de {SITE.ville}</p>
      <ul class="secteur__liste">
        {LIMITROPHES.map((c) => (
          <li class={c.note ? 'secteur__item secteur__item--cle' : 'secteur__item'}>
            <span class="secteur__nom">{c.nom}</span>
            {c.note && <span class="secteur__note">{c.note}</span>}
          </li>
        ))}
      </ul>
      <p class="secteur__pied">
        Boxing Center accueille les habitants de {SITE.ville} et du {SITE.secteur}
        {' '}dans son club de {DESTINATION.ville}. Accès par {VILLE.routes.valeur}&nbsp;;
        en transports, {VILLE.bus.valeur}.
        {' '}<a class="lien" href={DESTINATION.site} rel="noopener">Le site du club ↗</a>
      </p>
    </div>
  </section>

  {/* ─────────── 05 — LE MIDI ─────────── */}
  <section class="section midi" id="midi" aria-labelledby="t-midi">
    <div class="enveloppe midi__inner">
      <div>
        <p class="cartouche"><span class="cartouche__num">05</span><span>Le midi</span></p>
        <p class="midi__grand">
          <span>{DESTINATION.ouvertureTexte}</span>
          <span class="midi__fleche" aria-hidden="true">→</span>
          <span>{DESTINATION.fermetureTexte}</span>
        </p>
        <p class="mono midi__jours">six jours sur sept · {COURS} cours par semaine</p>
      </div>
      <div class="midi__texte">
        <h2 id="t-midi">
          Tu travailles à l’Innopole&nbsp;?<br />
          <span class="midi__accent">À midi, le club est déjà ouvert.</span>
        </h2>
        <p class="lead faible">
          Les cours de boxe accessibles depuis {SITE.ville} vont du lundi au samedi, de
          {' '}{DESTINATION.ouvertureTexte} à {DESTINATION.fermetureTexte}. {majuscule(VILLE.figure.valeur)}&nbsp;:
          ce site parle aux deux, et la {BUS.code} passe par la gare et le village d’entreprise.
        </p>
        <ul class="midi__args">
          <li><span class="midi__tiret" aria-hidden="true"></span>Un créneau le midi, entre deux réunions</li>
          <li><span class="midi__tiret" aria-hidden="true"></span>Un créneau en sortie de bureau</li>
          <li><span class="midi__tiret" aria-hidden="true"></span>Le samedi, pour les semaines trop pleines</li>
        </ul>
        <a class="bouton" href={DESTINATION.plannings} rel="noopener">
          <span>Repérer le créneau du midi sur le planning</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 06 — LE MOTEUR ─────────── */}
  <Seance titre={'Ton cours et ton créneau,\nen deux réponses.'} numero="06" />

  {/* ─────────── 07 — LA PREMIÈRE FOIS ─────────── */}
  <section class="section creuse premiere" id="premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" legende />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">07</span><span>La première fois</span></p>
        <h2 id="t-premiere">
          Ta première séance,<br />
          <span class="premiere__accent">avec les gants du club.</span>
        </h2>
        <ol class="premiere__etapes">
          <li>
            <span class="mono">01</span>
            <p><strong>Le club prête les gants.</strong> Tu apportes une tenue de sport, une bouteille d’eau et une serviette.</p>
          </li>
          <li>
            <span class="mono">02</span>
            <p><strong>Tu frappes.</strong> De la corde, un geste décomposé lentement par le coach, du sac, puis les pattes d’ours.</p>
          </li>
          <li>
            <span class="mono">03</span>
            <p><strong>Chacun est occupé à sa propre séance.</strong> Le coach te suit, le reste de la salle a la tête dans son travail.</p>
          </li>
          <li>
            <span class="mono">04</span>
            <p><strong>Tu repars essoufflé, et content d’être venu.</strong> C’est le seul objectif d’une première séance.</p>
          </li>
        </ol>
        <div class="premiere__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Réserver ma première séance</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LES QUESTIONS ─────────── */}
  <section class="section questions" id="questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">08</span><span>Ce qu’on nous demande</span></p>
        <h2 id="t-questions">
          {majuscule(enLettres(QUESTIONS.length))} questions,<br />
          <span class="questions__accent">{enLettres(QUESTIONS.length)} réponses courtes.</span>
        </h2>
        <p class="lead faible">
          Chacune s’ouvre sur ce qui est vrai. Si la tienne manque, appelle le club au
          {' '}<a class="lien" href={`tel:${CONTACT.telephoneLien.valeur}`}>{CONTACT.telephone.valeur}</a>,
          ou <a class="lien" href={route('contact').chemin}>écris-nous en deux lignes →</a>
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section encre convergence" id="decider" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Ta séance d’essai se réserve<br />
        <span class="convergence__accent">sur le site du club.</span>
      </h2>
      <p class="lead convergence__texte">
        Si tu préfères demander d’abord, appelle le club, ou écris-nous en deux
        lignes&nbsp;: on te répond avec un créneau.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Le formulaire de contact</span><span class="fleche" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 Le club ────────────────────────────────────────────────────── */
  .octogone__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .octogone__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .octogone h2 { max-width: 18ch; margin-bottom: var(--e-5); }
  .octogone__accent { color: var(--signal-texte); }
  .octogone .lead { max-width: 48ch; margin-bottom: var(--e-4); }
  .octogone .lead strong { color: var(--encre); font-weight: 600; }
  .octogone .faible { max-width: 56ch; }
  .octogone__faits { display: grid; gap: 0; margin: var(--e-5) 0 0; max-width: 32rem; }
  .octogone__faits > div { display: grid; gap: 0.15rem; padding: var(--e-3) 0; border-top: 1px solid var(--trait); }
  .octogone__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  .octogone__faits dt { color: var(--graphite); }
  .octogone__faits dd { margin: 0; font-size: var(--t-petit); font-weight: 600; }
  .octogone__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); margin-top: var(--e-6); }
  .octogone__actions .lien { font-size: var(--t-petit); }

  /* ── 03 Y aller ────────────────────────────────────────────────────── */
  .trajet__tete {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .trajet__tete { grid-template-columns: 1fr; gap: var(--e-4); margin-bottom: var(--e-5); } }
  .trajet h2 { max-width: 20ch; }
  .trajet__accent { color: var(--signal-texte); }
  .trajet__tete .lead { max-width: 50ch; }

  .trajet__lignes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-3);
    margin-top: var(--e-7);
  }
  .trajet__lignes a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'code parcours' 'code jours';
    gap: 0.15rem var(--e-4);
    align-items: center;
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-1);
    background: var(--papier-vif);
    text-decoration: none;
    transition:
      border-color var(--d-rapide) var(--e-mecanique),
      transform var(--d-normal) var(--e-sortie);
  }
  .trajet__lignes a:hover { border-color: var(--signal-texte); transform: translateX(4px); }
  .trajet__code {
    grid-area: code;
    display: grid;
    place-items: center;
    min-width: 3.2rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.35rem;
    background: var(--encre);
    color: var(--papier-vif);
    font-family: var(--police-mono);
    font-size: var(--t-petit);
    font-weight: 700;
  }
  .trajet__code--metro { background: var(--signal-texte); }
  .trajet__parcours { grid-area: parcours; font-weight: 600; font-size: var(--t-petit); }
  .trajet__jours { grid-area: jours; color: var(--graphite); text-transform: none; letter-spacing: 0.05em; }
  .trajet__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  /* ── 04 Le secteur ─────────────────────────────────────────────────── */
  .secteur__tete {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 62rem) { .secteur__tete { grid-template-columns: 1fr; } }
  .secteur h2 { max-width: 24ch; }
  .secteur__accent { color: var(--signal-texte); }
  .secteur__intro { max-width: 50ch; }

  .secteur__pages {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--e-4);
    margin-bottom: var(--e-8);
  }
  .carte {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-1);
    background: var(--papier-vif);
    text-decoration: none;
    transition:
      border-color var(--d-rapide) var(--e-mecanique),
      transform var(--d-normal) var(--e-sortie);
  }
  .carte:hover { border-color: var(--signal-texte); transform: translateY(-3px); }
  .carte__cp { color: var(--graphite); }
  .carte__nom {
    font-family: var(--police-titre);
